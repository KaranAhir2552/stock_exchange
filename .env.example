# Copy to .env.<network> (git-ignored). Secrets and per-machine settings only;
# everything else lives in config/<network>.json.
HERMES_API_KEY=

# Scripts (admin): deploys, config, calendar, pools. Defaults to ~/.config/solana/id.json.
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
# Optional: separate guardian/treasury for init-config (default: the admin key).
GUARDIAN_PUBKEY=
TREASURY_PUBKEY=

# Keeper
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json
KEEPER_INTERVAL_SECS=60
# localnet/devnet only: re-post the current mock price each round (keeper key must be the admin).
KEEPER_MOCK_HEARTBEAT=false
KEEPER_MAX_PRIORITY_MICROLAMPORTS=100000
KEEPER_ALERT_AFTER_SECS=300
KEEPER_ALERT_WEBHOOK=
KEEPER_PORT=9464

# Phase 7 services
DATABASE_URL=postgres://afterbell:afterbell@localhost:5432/afterbell
REDIS_URL=redis://localhost:6379
